{
  "$schema": "https://v6.gh-proxy.org/github.com/reF1nd/sing-box/raw/reF1nd-testing/docs/schema.json",
  "providers": [
    {
      "tag": "自建",
      "type": "remote",
      "path": "./providers/自建.json",
      "url": "http://localhost:5200/download/%E8%87%AA%E5%BB%BA",
      "health_check": {
        "enabled": true,
        "url": "https://www.gstatic.com/generate_204",
        "interval": "10m"
      }
    }
  ],
  "log": {
    "disabled": false,
    "level": "fatal",
    "timestamp": true,
    "output": "sing-box.log"
  },
  "experimental": {
    "urltest_unified_delay": true,
    "cache_file": {
      "enabled": true,
      "store_dns": true,
      "store_fakeip": true
    },
    "clash_api": {
      "secret": "",
      "default_mode": "Rule",
      "external_ui": "dashboard",
      "external_controller": "0.0.0.0:9090",
      "external_ui_download_url": "https://v6.gh-proxy.org/github.com/Zephyruso/zashboard/releases/download/v3.22.0/dist.zip",
      "access_control_allow_origin": "*",
      "access_control_allow_private_network": true
    }
  },
  "services": [
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9191,
      "secret": "",
      "access_control_allow_origin": "*",
      "access_control_allow_private_network": true
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns-hosts",
        "type": "hosts",
        "predefined": {
          "services.googleapis.cn": [
            "64.233.188.94",
            "64.233.189.94"
          ]
        }
      },
      {
        "tag": "dns-resolver",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-ali",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "dns-resolver"
      },
      {
        "tag": "dns-tencent",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "dns-resolver"
      },
      {
        "tag": "dns-cloudflare",
        "type": "https",
        "server": "cloudflare-dns.com",
        "detour": "GLOBAL"
      },
      {
        "tag": "dns-google",
        "type": "https",
        "server": "dns.google",
        "detour": "GLOBAL"
      },
      {
        "tag": "dns-direct",
        "type": "group",
        "servers": [
          "dns-ali",
          "dns-tencent"
        ]
      },
      {
        "tag": "dns-global",
        "type": "group",
        "servers": [
          "dns-cloudflare",
          "dns-google"
        ]
      },
      {
        "tag": "dns-fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "preferred_by": "dns-hosts",
        "server": "dns-hosts"
      },
      {
        "clash_mode": "Direct",
        "server": "dns-direct"
      },
      {
        "clash_mode": "Global",
        "server": "dns-global"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": "GeoSite-AdBlock"
          }
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "query_type": [
          "SVCB",
          "HTTPS"
        ],
        "action": "predefined",
        "rcode": "NOTIMP"
      },
      {
        "rule_set": [
          "GeoSite-FakeIP-Filter",
          "GeoSite-China"
        ],
        "server": "dns-direct"
      },
      {
        "tag": "evaluate",
        "rule_set": "Geo-Proxy",
        "invert": true,
        "action": "evaluate",
        "server": "dns-google",
        "client_subnet": "1.0.1.0/24"
      },
      {
        "match_response": "evaluate",
        "rule_set": "GeoIP-China",
        "server": "dns-direct"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns-fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "dns-global",
    "strategy": "prefer_ipv4",
    "optimistic": true,
    "reverse_mapping": true,
    "round_robin_cache": true
  },
  "http_clients": [
    {
      "tag": "sub-client",
      "detour": "📦 订阅更新"
    }
  ],
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7890
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "mtu": 9000,
      "stack": "gvisor",
      "dns_mode": "hijack",
      "interface_name": "Box",
      "address": "172.18.0.1/30",
      "auto_route": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "tag": "⛔️ 拒绝连接",
      "type": "block"
    },
    {
      "tag": "🌐 本地直连",
      "type": "direct"
    },
    {
      "tag": "♻️ 自动选择",
      "type": "urltest",
      "use_all_providers": true
    },
    {
      "tag": "🎯 手动选择",
      "type": "selector",
      "use_all_providers": true
    },
    {
      "tag": "📦 订阅更新",
      "type": "selector",
      "use_all_providers": true,
      "outbounds": [
        "♻️ 自动选择",
        "🎯 手动选择",
        "🌐 本地直连",
        "⛔️ 拒绝连接"
      ]
    },
    {
      "tag": "💌 谷歌推送",
      "type": "selector",
      "use_all_providers": true,
      "outbounds": [
        "♻️ 自动选择",
        "🎯 手动选择",
        "🌐 本地直连",
        "⛔️ 拒绝连接"
      ]
    },
    {
      "tag": "🇨🇳 国内直连",
      "type": "selector",
      "use_all_providers": true,
      "outbounds": [
        "♻️ 自动选择",
        "🎯 手动选择",
        "🌐 本地直连",
        "⛔️ 拒绝连接"
      ]
    },
    {
      "tag": "🇺🇳 国外代理",
      "type": "selector",
      "use_all_providers": true,
      "outbounds": [
        "♻️ 自动选择",
        "🎯 手动选择",
        "🌐 本地直连",
        "⛔️ 拒绝连接"
      ]
    },
    {
      "tag": "🍥 漏网之鱼",
      "type": "selector",
      "use_all_providers": true,
      "outbounds": [
        "♻️ 自动选择",
        "🎯 手动选择",
        "🌐 本地直连",
        "⛔️ 拒绝连接"
      ]
    },
    {
      "tag": "GLOBAL",
      "type": "selector",
      "use_all_providers": true,
      "outbounds": [
        "♻️ 自动选择",
        "🎯 手动选择",
        "🌐 本地直连",
        "⛔️ 拒绝连接",
        "📦 订阅更新",
        "💌 谷歌推送",
        "🇨🇳 国内直连",
        "🇺🇳 国外代理",
        "🍥 漏网之鱼"
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "🌐 本地直连"
      },
      {
        "clash_mode": "Direct",
        "outbound": "🌐 本地直连"
      },
      {
        "clash_mode": "Global",
        "outbound": "GLOBAL"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": "GeoSite-AdBlock"
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": "GeoSite-GoogleFCM",
        "outbound": "💌 谷歌推送"
      },
      {
        "rule_set": "Geo-Proxy",
        "outbound": "🇺🇳 国外代理"
      },
      {
        "rule_set": "GeoSite-China",
        "outbound": "🇨🇳 国内直连"
      },
      {
        "rule_set": "GeoIP-China",
        "outbound": "🇨🇳 国内直连"
      }
    ],
    "final": "🍥 漏网之鱼",
    "find_process": true,
    "auto_detect_interface": true,
    "default_http_client": "sub-client",
    "default_domain_resolver": "dns-direct",
    "default_domain_match_strategy": "prefer_fqdn",
    "rule_set": [
      {
        "tag": "GeoSite-AdBlock",
        "type": "remote",
        "path": "./rules/GeoSite-AdBlock.srs",
        "url": "https://v6.gh-proxy.org/github.com/privacy-protection-tools/anti-ad.github.io/raw/master/docs/anti-ad-sing-box.srs"
      },
      {
        "tag": "GeoSite-GoogleFCM",
        "type": "remote",
        "path": "./rules/GeoSite-GoogleFCM.srs",
        "url": "https://v6.gh-proxy.org/github.com/MetaCubeX/meta-rules-dat/raw/sing/geo/geosite/googlefcm@!cn.srs"
      },
      {
        "tag": "Geo-Proxy",
        "type": "remote",
        "path": "./rules/Geo-Proxy.srs",
        "url": "https://v6.gh-proxy.org/github.com/QuixoticHeart/rule-set/raw/ruleset/singbox/version2/proxy.srs"
      },
      {
        "tag": "GeoSite-China",
        "type": "remote",
        "path": "./rules/GeoSite-China.srs",
        "url": "https://v6.gh-proxy.org/github.com/QuixoticHeart/rule-set/raw/ruleset/singbox/version2/cn.srs"
      },
      {
        "tag": "GeoIP-China",
        "type": "remote",
        "path": "./rules/GeoIP-China.srs",
        "url": "https://v6.gh-proxy.org/github.com/QuixoticHeart/rule-set/raw/ruleset/singbox/version2/cncidr.srs"
      },
      {
        "tag": "GeoSite-FakeIP-Filter",
        "type": "remote",
        "path": "./rules/GeoSite-FakeIP-Filter.srs",
        "url": "https://v6.gh-proxy.org/github.com/QuixoticHeart/rule-set/raw/ruleset/singbox/version2/fake-ip-filter.srs"
      }
    ]
  }
}